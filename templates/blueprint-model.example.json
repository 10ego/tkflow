  "flows": [
    {
      "id": "open-request",
      "from": "inbox",
      "to": "brief",
      "trigger": "Open Cedar Bakery request · B-001"
    },
    {
      "id": "submit-review",
      "from": "brief",
      "to": "review",
      "trigger": "Send saved brief for review · B-003"
    },
    {
      "id": "return-inbox",
      "from": "review",
      "to": "inbox",
      "trigger": "After approval, return to requests · B-003"
    }
  ],
  "entities": [
    {
      "id": "request",
      "name": "Request",
      "fields": [
        "Client name",
        "Desired outcome",
        "Received date",
        "Status"
      ]
    },
    {
      "id": "brief",
      "name": "Brief",
      "fields": [
        "Request reference",
        "Scope and constraints",
        "Direction rationale",
        "Saved version"
      ],
      "why": "Keep the reason beside each proposal."
    },
    {
      "id": "approval",
      "name": "Approval",
      "fields": [
        "Brief version",
        "Reviewer",
        "Decision time"
      ]
    }
  ],
  "rules": [
    {
      "id": "B-001",
      "category": "access",
      "strength": "must",
      "text": "Studio members can open requests in their shared inbox.",
      "why": "The example assumes a private studio workspace.",
      "provenance": "provisional",
      "source": "Synthetic renderer fixture"
    },
    {
      "id": "B-002",
      "category": "data",
      "strength": "must",
      "text": "A failed save leaves the draft text visible and available to retry.",
      "why": "A transient failure should not erase the author’s work.",
      "provenance": "stated",
      "source": "Synthetic renderer fixture"
    },
    {
      "id": "B-003",
      "category": "behavior",
      "strength": "must",
      "text": "Approval records the exact saved brief version the reviewer saw.",
      "why": "Later edits must not silently change an approved direction.",
      "provenance": "stated",
      "source": "Synthetic renderer fixture"
    },
    {
      "id": "B-004",
      "category": "feel",
      "strength": "should",
      "text": "Explain problems with a clear next action and calm wording.",
      "why": "Review should help the studio move work forward.",
      "provenance": "inferred",
      "source": "Synthetic visual direction"
    }
  ],
  "decisions": [
    {
      "id": "D-001",
      "question": "When a brief changes after approval, what should the reviewer see?",
      "options": [
        "A new review request",
        "A change summary beside the existing approval"
      ],
      "recommendation": "A new review request, provisionally, so the approval stays attached to its original version."
    }
  ]
}
