{
  "version": 1,
  "title": "Studio Desk",
  "intent": "A small design studio turns incoming client requests into clear briefs, without losing the reason behind a revision.",
  "platform": "desktop",
  "theme": {
    "primary": "#315bc7",
    "accent": "#a54b15",
    "surface": "#f3f6fb",
    "density": "comfortable",
    "tone": "Calm, precise and welcoming; important decisions stay visible."
  },
  "observations": [
    "Synthetic reference for renderer verification; not an approved user product.",
    "Requests, brief editing and review form one continuous journey."
  ],
  "assumptions": [
    "Desktop layout and the sample copy are provisional example choices."
  ],
