{
  "name": "tkflow",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "description": "Obsidian-first blueprints, vertical slices, and fresh-agent continuation",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/10ego/tkflow.git"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./plugins/opencode.mjs"
  },
  "bin": {
    "tkflow": "./src/cli.mjs"
  },
  "files": [
    "src",
    "plugins",
    "skills",
    "templates",
    ".codex-plugin",
    ".claude-plugin",
    ".agents"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build:components": "node scripts/build-components.mjs"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.17"
  },
  "keywords": [
    "pi-package",
    "opencode-plugin"
  ],
  "pi": {
    "skills": [
      "./skills/tkflow"
    ],
    "extensions": [
      "./plugins/pi.mjs"
    ]
  }
}
